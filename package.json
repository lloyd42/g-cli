{
  "name": "@lloyd42/g-cli",
  "version": "1.0.0",
  "description": "A lightweight, flexible CLI for scaffolding front-end projects from templates.",
  "main": "dist/index.js",
  "bin": {
    "g-cli": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "postbuild": "copyfiles -u 1 src/**/*.json dist/",
    "test": "vitest",
    "test:cov": "vitest run --coverage",
    "test:e2e": "playwright test"
  },
  "keywords": [
    "cli",
    "scaffold",
    "template",
    "generator",
    "frontend"
  ],
  "author": "lloyd42",
  "license": "MIT",
  "homepage": "https://github.com/lloyd42/g-cli#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lloyd42/g-cli.git"
  },
  "bugs": {
    "url": "https://github.com/lloyd42/g-cli/issues"
  },
  "packageManager": "pnpm@10.13.1",
  "devDependencies": {
    "@types/degit": "^2.8.6",
    "@types/node": "^24.0.15",
    "@types/fs-extra": "^11.0.4",
    "typescript": "^5.8.3",
    "copyfiles": "^2.4.1",
    "vitest": "^2.0.4",
    "@vitest/coverage-v8": "^2.0.4",
    "@playwright/test": "^1.45.3"
  },
  "dependencies": {
    "fs-extra": "^11.2.0",
    "chalk": "^5.4.1",
    "commander": "^14.0.0",
    "degit": "^2.8.4",
    "inquirer": "^12.8.2",
    "ora": "^8.2.0"
  }
}